# Copy to `.env` for docker compose, or export these in `.envrc` for
# `make run/api`. Neither file is committed (see .gitignore).

# Postgres password for the "greenlight" role used by docker compose.
POSTGRES_PASSWORD=pa55word

# Secret used to sign and verify JWTs. Generate your own with:
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me-before-production

# DSN used by `make run/api` when running natively against a local Postgres.
GREENLIGHT_DB_DSN=postgres://greenlight:pa55word@localhost:5432/greenlight?sslmode=disable
